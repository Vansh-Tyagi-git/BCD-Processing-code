from sklearn.metrics import mean_squared_error, r2_score

def evaluate(y_test, pred, name):
    rmse = np.sqrt(mean_squared_error(y_test, pred))
    r2 = r2_score(y_test, pred)

    print(f"{name}")
    print("RMSE:", rmse)
    print("R2:", r2)
    print("-----")

evaluate(y_test, pred_en, "ElasticNet")
evaluate(y_test, pred_rf, "RandomForest")
evaluate(y_test, pred_gb, "GradientBoosting")
evaluate(y_test, pred_svr, "SVR")
evaluate(y_test, pred_nn, "NeuralNet")

