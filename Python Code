from scipy.interpolate import interp1d
from scipy.stats import linregress

voltage_grid = np.linspace(2.0, 3.5, 500)

feature_rows = []

for df in df_list:

    # cleaning
    df = df[(df['Voltage'] > 0) & (df['Temperature'] < 100)]
    df_ml = df[df['Cycle_Index'] > 0]

    if df_ml.empty:
        continue

    # 🔋 cycle life (target)
    cycle_life = df_ml['Cycle_Index'].max()

    # -------------------------
    # Feature 1: Capacity ratio
    # -------------------------
    try:
        cap2 = df_ml[df_ml['Cycle_Index']==2]['Discharge_Capacity'].max()
        cap100 = df_ml[df_ml['Cycle_Index']==100]['Discharge_Capacity'].max()
        cap_ratio = cap100 / cap2
    except:
        continue

    # -------------------------
    # Feature 2: Slope (95–100)
    # -------------------------
    cycle_capacity = df_ml.groupby('Cycle_Index')['Discharge_Capacity'].max()

    if not all(c in cycle_capacity.index for c in range(95,101)):
        continue

    x = np.array(range(95,101))
    y = cycle_capacity.loc[95:100].values
    slope, _, _, _, _ = linregress(x,y)

    # -------------------------
    # Feature 3: ΔQ variance
    # -------------------------
    df1 = df_ml[(df_ml['Cycle_Index']==10) & (df_ml['Current']<0)]
    df2 = df_ml[(df_ml['Cycle_Index']==100) & (df_ml['Current']<0)]

    if df1.empty or df2.empty:
        continue

    df1 = df1.sort_values('Voltage').drop_duplicates('Voltage')
    df2 = df2.sort_values('Voltage').drop_duplicates('Voltage')

    f1 = interp1d(df1['Voltage'], df1['Discharge_Capacity'], fill_value="extrapolate")
    f2 = interp1d(df2['Voltage'], df2['Discharge_Capacity'], fill_value="extrapolate")

    q1 = f1(voltage_grid)
    q2 = f2(voltage_grid)

    delta_q = q2 - q1
    delta_var = np.var(delta_q)

    # -------------------------
    # Add row
    # -------------------------
    feature_rows.append({
        "cap_ratio": cap_ratio,
        "slope": slope,
        "delta_var": delta_var,
        "cycle_life": cycle_life
    })

# final dataframe
df_features = pd.DataFrame(feature_rows)

