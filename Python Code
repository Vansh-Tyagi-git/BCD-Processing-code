from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.linear_model import LinearRegression
from sklearn.svm import SVR

models = {
    "Random Forest": RandomForestRegressor(n_estimators=100),
    "Gradient Boosting": GradientBoostingRegressor(),
    "Linear Regression": LinearRegression(),
    "SVR": SVR()
}

model_results = {}

for name, model in models.items():

    # train
    model.fit(X_train, y_train)

    # predict
    pred = model.predict(X_test)

    # store results
    model_results[name] = {
        "model": model,
        "pred": pred
    }

plt.figure(figsize=(8,6))

colors = plt.cm.plasma(np.linspace(0,1,len(models)))

for i, (name, result) in enumerate(model_results.items()):

    pred = result["pred"]

    plt.scatter(
        np.exp(y_test),
        np.exp(pred),
        color=colors[i],
        label=name,
        alpha=0.7,
        s=60
    )

# ideal line
plt.plot([100,1500], [100,1500], 'k--')

plt.xlabel("Actual Life")
plt.ylabel("Predicted Life")
plt.title("Prediction vs Actual (All Models)")
plt.yticks(range(100,1501,100))
plt.xticks(range(100,1501,100))
plt.legend()
plt.grid()
plt.show()

import matplotlib.pyplot as plt
import numpy as np

# Get predictions for the Linear Regression model
pred_lr = model_results["Linear Regression"]["pred"]

# Features used for training and prediction
features = ['cap_ratio', 'slope', 'delta_var']

# Create subplots, one for each feature
fig, ax = plt.subplots(1, len(features), figsize=(18, 5), sharey=True)

for i in range(len(features)):
    ax[i].scatter(X_test[:, i], np.exp(y_test), label='Actual Cycle Life', alpha=0.7)
    ax[i].scatter(X_test[:, i], np.exp(pred_lr), color='orange', label='Predicted Cycle Life', alpha=0.7)
    ax[i].set_xlabel(features[i].replace('_', ' ').title())
    ax[i].set_title(f"Feature: {features[i].replace('_', ' ').title()}")
    ax[i].grid(True, linestyle='--', alpha=0.5)

    # Apply x-scale for delta_var if needed, consistent with previous plots
    if features[i] == 'delta_var':
        ax[i].set_xscale('log')

ax[0].set_ylabel("Cycle Life")
ax[0].legend()

fig.suptitle("Linear Regression: Actual vs. Predicted Cycle Life per Feature")
plt.tight_layout(rect=[0, 0.03, 1, 0.95]) # Adjust layout to prevent title overlap
plt.show()
